---
import Layout from '../layouts/Layout.astro';
---

<Layout title="PHI Python Tutorial | BASPLib">
    <div class="max-w-5xl mx-auto space-y-6">

        <header>
            <a href="/RI_measurment_operator" class="text-sm font-bold text-[#6E898A] hover:text-[#CF9E5F] transition-colors flex items-center gap-2 mb-4 w-fit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                Back to PHI
            </a>
            <h1 class="text-3xl md:text-4xl font-extrabold tracking-tighter mb-2 text-[#292350]">
                PHI Python Tutorial
            </h1>
            <!--<p class="text-[#6E898A] italic">Interactive Jupyter Environment Visualization</p>-->
        </header>

        <div class="bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden flex flex-col">
            <div class="bg-slate-100 border-b border-slate-200 px-4 py-3 flex items-center gap-3">
                <img src="/images/logo/jupyter.png" alt="Jupyter Logo" class="h-6 w-auto object-contain" />
                <span class="text-sm font-bold text-slate-600 font-mono">tutorial_ri_measurement_operator_python.ipynb</span>
            </div>

            <div class="w-full bg-white">
                <iframe
                    id="notebook-iframe-phi-python"
                    src="/notebooks/tutorial_ri_measurement_operator_python.html"
                    class="w-full border-none block"
                    scrolling="no"
                    title="Jupyter Notebook Tutorial PHI Python">
                </iframe>
            </div>
        </div>
    </div>
</Layout>

<script>
    function resizeIframe() {
        const iframe = document.getElementById('notebook-iframe-phi-python') as HTMLIFrameElement;
        if (iframe && iframe.contentWindow) {
            try {
                const newHeight = iframe.contentWindow.document.documentElement.scrollHeight;
                iframe.style.height = (newHeight + 50) + 'px';
            } catch (error) {
                console.warn("Iframe resizing blocked or not ready:", error);
            }
        }
    }

    const iframeElement = document.getElementById('notebook-iframe-phi-python');
    if (iframeElement) {
        iframeElement.addEventListener('load', () => {
            resizeIframe();
            setTimeout(resizeIframe, 500);
            setTimeout(resizeIframe, 2000);
        });
    }
</script>