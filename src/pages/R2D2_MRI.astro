---
import Layout from '../layouts/Layout.astro';
---

<Layout title="R2D2 MRI | BASPLib">
    <div class="max-w-4xl mx-auto space-y-12">

        <header>
            <a href="/R2D2" class="text-sm font-bold text-[#6E898A] hover:text-[#CF9E5F] transition-colors flex items-center gap-2 mb-4 w-fit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                Back to R2D2
            </a>

            <h1 class="text-4xl md:text-5xl font-extrabold tracking-tighter mb-4 inline-block pr-2 bg-gradient-to-r from-[#292350] via-[#432E60] to-[#CF9E5F] bg-clip-text text-transparent">
                R2D2 MRI
            </h1>
            <h2 class="text-sm md:text-base font-bold uppercase tracking-[0.2em] text-[#6E898A] opacity-80 italic border-b border-slate-200 pb-4">
                Residual-to-Residual DNN series for high-Dynamic range imaging
            </h2>
        </header>

        <section>
            <h3 class="text-2xl font-bold text-[#2F3E5E] mb-6 flex items-center gap-3 border-b border-slate-200 pb-2">
                Papers & Codes
            </h3>

            <div class="space-y-6">
                <article class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                    <p class="text-slate-700 mb-4">
                        <strong class="text-[#292350] block mb-1">The R2D2 Deep Neural Network Series for Scalable Non-Cartesian Magnetic Resonance Imaging</strong>
                        Y. Chen, A. Aghabiglou, S. Chen, M. Torki, C. Tang, R. B van Heeswijk, Y. Wiaux,<br>
                        <i class="text-[#6E898A]">Submitted for publication at TCI</i>, 2025.<br>
                        <a href="https://arxiv.org/abs/2503.09559" class="text-[#CF9E5F] hover:underline font-medium">arXiv:2503.09559v2</a>
                    </p>
                    <div class="flex items-center gap-4 bg-[#292350]/5 p-4 rounded-xl">
                        <span class="font-bold text-sm text-[#2F3E5E]">R2D2 MRI <span class="text-[#CF9E5F]">V1.0</span> & Tutorial:</span>
                        <a href="#" title="MATLAB" class="opacity-80 hover:opacity-100 transition-opacity">
                            <img src="/images/logo/R2D2_coming_soon.png" alt="Coming Soon Logo" class="h-8 w-auto object-contain" />
                        </a>
                    </div>
                </article>

                <article class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                    <p class="text-slate-700 mb-2">
                        <strong class="text-[#292350] block mb-1">Scalable Non-Cartesian Magnetic Resonance Imaging with R2D2</strong>
                        Y. Chen, C. Tang, A. Aghabiglou, C. S. Chu, Y. Wiaux,<br>
                        <i class="text-[#6E898A]">IEEE EUSIPCO 2024</i>, 1511-1515, 2024.<br>
                        <a href="https://arxiv.org/abs/2403.17905" class="text-[#CF9E5F] hover:underline font-medium">arXiv:2403.17905</a> |
                        <a href="https://doi.org/10.23919/EUSIPCO63174.2024.10714974" target="_blank" class="text-[#CF9E5F] hover:underline font-medium">DOI:10.23919/EUSIPCO63174.2024.10714974</a>
                    </p>
                </article>
            </div>
        </section>

    </div>
</Layout>