---
import Layout from '../layouts/Layout.astro';
---

<Layout title="HyperAIRI | BASPLib">
    <div class="max-w-4xl mx-auto space-y-12">

        <header>
            <a href="/AIRI" class="text-sm font-bold text-[#6E898A] hover:text-[#CF9E5F] transition-colors flex items-center gap-2 mb-4 w-fit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                Back to AIRI
            </a>
            <h1 class="text-4xl md:text-5xl font-extrabold tracking-tighter mb-4 inline-block pr-2 bg-gradient-to-r from-[#292350] via-[#432E60] to-[#CF9E5F] bg-clip-text text-transparent">
                HyperAIRI
            </h1>
            <h2 class="text-sm md:text-base font-bold uppercase tracking-[0.2em] text-[#6E898A] opacity-80 italic border-b border-slate-200 pb-4">
                A Plug-and-play Algorithm for RI Hyperspectral Image Reconstruction
            </h2>
        </header>

        <section>
            <h3 class="text-2xl font-bold text-[#2F3E5E] mb-6 flex items-center gap-3 border-b border-slate-200 pb-2">
                Main codes & Tutorials
            </h3>
            <div class="grid md:grid-cols-2 gap-6">
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md hover:border-[#CF9E5F]/50 transition-all duration-300">
                    <h4 class="font-bold text-[#292350] mb-4 pb-2 border-b border-slate-100">HyperAIRI V1.0</h4>
                    <div class="flex items-center gap-4">
                        <img src="/images/logo/GitHub-logo2.png" alt="GitHub Logo" class="h-8 w-auto object-contain" />
                        <a href="#" target="_blank" title="Python (Coming Soon)" class="opacity-80 hover:opacity-100 transition-opacity">
                            <img src="/images/logo/R2D2_coming_soon.png" alt="Coming Soon Logo" class="h-8 w-auto object-contain" />
                        </a>
                    </div>
                </div>

                <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md hover:border-[#CF9E5F]/50 transition-all duration-300">
                    <h4 class="font-bold text-[#292350] mb-4 pb-2 border-b border-slate-100">HyperAIRI Tutorials</h4>
                    <div class="flex items-center gap-4">
                        <a href="#" title="Jupyter Notebook (Coming Soon)" class="opacity-80 hover:opacity-100 transition-opacity">
                            <img src="/images/logo/R2D2_coming_soon.png" alt="Coming Soon Logo" class="h-8 w-auto object-contain" />
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section>
            <h3 class="text-2xl font-bold text-[#2F3E5E] mb-6 flex items-center gap-3 border-b border-slate-200 pb-2">
                Papers & Codes
            </h3>

            <div class="space-y-6">
                <article class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                    <p class="text-slate-700 mb-4">
                        <strong class="text-[#292350] block mb-1">HyperAIRI: A Plug-and-play Algorithm for Precise Hyperspectral Image Reconstruction in Radio Interferometry</strong>
                        C. Tang, A. Dabbech, A. Jackson, Y. Wiaux,<br>
                        <i class="text-[#6E898A]">ApJS</i>, 283(1):9, 2026.<br>
                        <a href="https://arxiv.org/abs/2510.15198" target="_blank" class="text-[#CF9E5F] hover:underline font-medium">ArXiv:2510.15198</a> |
                        <a href="https://iopscience.iop.org/article/10.3847/1538-4365/ae3149" target="_blank" class="text-[#CF9E5F] hover:underline font-medium">DOI:10.3847/1538-4365/ae3149</a>
                    </p>
                    <div class="flex items-center gap-4 bg-[#292350]/5 p-4 rounded-xl">
                        <span class="font-bold text-sm text-[#2F3E5E]">HyperAIRI<span class="text-[#CF9E5F]"> V1.0 </span> & Tutorial:</span>
                        <a href="#" title="MATLAB (Coming Soon)" class="opacity-80 hover:opacity-100 transition-opacity">
                            <img src="/images/logo/R2D2_coming_soon.png" alt="Coming Soon Logo" class="h-8 w-auto object-contain" />
                        </a>
                    </div>
                </article>
            </div>
        </section>

    </div>
</Layout>