---
import Layout from '../layouts/Layout.astro';
---

<Layout title="EIRA | BASPLib">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row gap-12 items-start">

        <div class="flex-1 space-y-8">
            <header class="mb-8">
                <h1 class="text-5xl md:text-6xl font-extrabold tracking-tighter mb-4 inline-block pr-2 bg-gradient-to-r from-[#292350] via-[#432E60] to-[#CF9E5F] bg-clip-text text-transparent">
                    EIRA
                </h1>
                <h2 class="text-sm md:text-base font-bold uppercase tracking-[0.2em] text-[#6E898A] italic border-b border-slate-200 pb-4">
                    Extreme-scale Imaging in Radio Astronomy
                </h2>
            </header>

            <blockquote class="border-l-4 border-[#CF9E5F] pl-6 py-3 bg-[#292350]/5 rounded-r-xl shadow-sm">
                <p class="text-xl font-bold text-[#2F3E5E] italic">
                    "A new EIRA is upon us."
                </p>
            </blockquote>

            <article class="space-y-6 text-lg leading-relaxed text-slate-700">
                <p>
                    EIRA is a highly parallelised code for extreme-scale RI in radio astronomy with R2D2, AIRI, or uSARA.
                </p>
            </article>

            <div class="pt-8 mt-8 border-t border-slate-200">
                <h3 class="text-2xl font-bold text-[#2F3E5E] mb-6 flex items-center gap-3">
                    Papers & Codes
                    <img src="/images/logo/GitHub-logo2.png" alt="GitHub Logo" class="h-8 w-auto object-contain" />
                </h3>

                <div class="flex flex-wrap gap-4">
                    <a href="#" class="group relative flex flex-col items-start gap-1 px-8 py-3.5 bg-[#292350] border border-[#292350] text-slate-100 font-bold rounded-xl shadow-md hover:shadow-lg hover:border-[#CF9E5F] transition-all duration-300 overflow-hidden">
                        <div class="absolute inset-0 bg-gradient-to-r from-transparent via-[#CF9E5F]/10 to-transparent translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"></div>
                        <div class="flex items-center gap-3 w-full">
                            <span class="relative z-10 text-lg">EIRA RI</span>
                            <svg class="relative z-10 w-4 h-4 text-[#CF9E5F]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
                        </div>
                        <span class="relative z-10 text-xs text-slate-400 font-normal italic">Will be available soon.</span>
                    </a>
                </div>
            </div>
        </div>

        <div class="w-full md:w-1/3 flex justify-center md:justify-end md:sticky top-32">
            <div class="relative group">
                <div class="absolute -inset-4 bg-gradient-to-br from-[#2F3E5E]/10 to-[#CF9E5F]/10 rounded-full blur-2xl opacity-50 group-hover:opacity-100 transition-opacity duration-500"></div>
                <img src="/images/DarthVader.png" alt="EIRA" class="relative w-64 md:w-full max-w-sm object-contain drop-shadow-2xl hover:scale-105 transition-transform duration-500" />
            </div>
        </div>

    </div>
</Layout>