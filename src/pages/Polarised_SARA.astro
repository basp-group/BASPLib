---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Polarised SARA | BASPLib">
    <div class="max-w-4xl mx-auto space-y-12">
        <header>
            <a href="/SARA_family" class="text-sm font-bold text-[#6E898A] hover:text-[#CF9E5F] transition-colors flex items-center gap-2 mb-4 w-fit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                Back to SARA
            </a>
            <h1 class="text-4xl md:text-5xl font-extrabold tracking-tighter mb-4 inline-block pr-2 bg-gradient-to-r from-[#292350] via-[#432E60] to-[#CF9E5F] bg-clip-text text-transparent">
                Polarised SARA
            </h1>
            <h2 class="text-sm md:text-base font-bold uppercase tracking-[0.2em] text-[#6E898A] opacity-80 italic border-b border-slate-200 pb-4">
                Polarised Sparsity Averaging Reweighted Analysis
            </h2>
        </header>

        <section>
            <h3 class="text-2xl font-bold text-[#2F3E5E] mb-6 flex items-center gap-3 border-b border-slate-200 pb-2">
                Main codes
            </h3>
            <div class="grid md:grid-cols-2 gap-6">
                <a href="https://github.com/basp-group/Polarised-SARA/" target="_blank" class="block bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md hover:border-[#CF9E5F]/50 transition-all duration-300 group">
                    <h4 class="font-bold text-[#292350] mb-4 pb-2 border-b border-slate-100 group-hover:text-[#CF9E5F] transition-colors">Polarised SARA RI V1.0</h4>
                    <div class="flex items-center gap-4">
                        <img src="/images/logo/GitHub-logo2.png" alt="GitHub Logo" class="h-8 w-auto object-contain" />
                    </div>
                </a>
            </div>
        </section>

        <section>
            <h3 class="text-2xl font-bold text-[#2F3E5E] mb-6 flex items-center gap-3 border-b border-slate-200 pb-2">
                Papers & Codes
            </h3>
            <div class="space-y-6">
                <article class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                    <p class="text-slate-700 mb-4">
                        <strong class="text-[#292350] block mb-1">Sparse interferometric Stokes imaging under polarization constraint (Polarized SARA)</strong>
                        J. Birdi, A. Repetti, and Y. Wiaux,<br>
                        <i class="text-[#6E898A]">MNRAS</i>, 478(4):4442-4463, 2018.<br>
                        <a href="https://arxiv.org/abs/1801.02417" target="_blank" class="text-[#CF9E5F] hover:underline font-medium">ArXiv:1801.02417</a> |
                        <a href="https://doi.org/10.1093/mnras/sty1182" target="_blank" class="text-[#CF9E5F] hover:underline font-medium">DOI: 10.1093/mnras/sty1182</a>
                    </p>
                    <div class="flex items-center gap-4 bg-[#292350]/5 p-4 rounded-xl">
                        <a href="https://github.com/basp-group/Polarised-SARA/" target="_blank" class="hover:scale-110 transition-transform">
                            <img src="/images/logo/GitHub-logo2.png" alt="GitHub Logo" class="h-6 w-auto object-contain" />
                        </a>
                    </div>
                </article>

                <article class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
                    <p class="text-slate-700 mb-2">
                        <strong class="text-[#292350] block mb-1">Scalable algorithm for polarization constrained sparse interferometric Stokes imaging</strong>
                        J. Birdi, A. Repetti, and Y. Wiaux,<br>
                        <i class="text-[#6E898A]">in Proc. IEEE SAM Workshop</i>, pp. 465-469, Sheffield, United Kingdom, July 2018.<br>
                        <a href="https://doi.org/10.1109/SAM.2018.8448968" target="_blank" class="text-[#CF9E5F] hover:underline font-medium">DOI:10.1109/SAM.2018.8448968</a>
                    </p>
                </article>
            </div>
        </section>
    </div>
</Layout>