---
// src/layouts/Layout.astro
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="Explore BASPLib, the comprehensive library for BASP Group, offering extensive resources and documentation." />
		<link rel="icon" type="image/x-icon" href="/images/logo/favicon.ico" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-slate-50 font-sans text-slate-900 selection:bg-orange-100 selection:text-orange-900 flex flex-col">

        <Navigation />

        <main class="flex-grow pt-32 pb-20 px-6">
			<slot /> </main>

        <footer class="bg-white border-t border-slate-200 py-12 mt-auto">
            <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-8">
                <p class="text-slate-400 text-sm">
                    © {currentYear} Biomedical and Astronomical Signal Processing Laboratory
                </p>
                <div class="flex gap-8 text-slate-400 text-sm font-semibold">
                    <a href="#" class="hover:text-orange-600 transition-colors">Privacy</a>
                    <a href="#" class="hover:text-orange-600 transition-colors">Terms</a>
                    <a href="/support_formspree" class="hover:text-[#CF9E5F] transition-colors">Contact</a>
                </div>
            </div>
        </footer>

	</body>
</html>